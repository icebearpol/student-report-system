{
  "name": "campus-report-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:student": "pnpm --filter student-mobile dev",
    "dev:admin": "pnpm --filter admin-web dev",
    "dev": "concurrently -k -n student,admin -c green,blue \"pnpm dev:student\" \"pnpm dev:admin\"",
    "build": "pnpm -r build",
    "build:admin": "pnpm --filter admin-web build",
    "build:student": "pnpm --filter student-mobile build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
